# Browser automation settings. Defaults are suitable for Docker.
BROWSER_HEADLESS=true
TELEGRAM_WEB_URL=https://web.telegram.org/k/
WEBSITE_URL=https://www.820010.xyz/
# The one-time `login` command opens a browser for this site.
# Set false on a machine with a display; leave true only if using another
# way to provision the website session.
WEBSITE_LOGIN_HEADLESS=false
LOGIN_TIMEOUT_SECONDS=300

# Required for alerts when either browser session expires, and for success alerts.
# Create a bot with @BotFather and send it a message first so it can message you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
NOTIFICATION_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
